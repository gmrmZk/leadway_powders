PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Use either DATABASE_URL or the individual DB_* settings.
DATABASE_URL=
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_PORT=5432

# SSL is enabled by default for PostgreSQL connections.
# Set to false only for a local database that does not support SSL.
DB_SSL=true
